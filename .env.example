# Copie para .env e ajuste se quiser. Tudo aqui é opcional.

# Pasta onde ficam o banco (financas.db) e os backups (backups/).
# Padrão: ControleFinanceiro/dados dentro da sua pasta pessoal
#   Windows: C:\Users\voce\ControleFinanceiro\dados
#   macOS:   /Users/voce/ControleFinanceiro/dados
#   Linux:   /home/voce/ControleFinanceiro/dados
# Aceita ~ no começo, por exemplo: ~/Documentos/financas
# DADOS_DIR=~/ControleFinanceiro/dados

# Porta do site em `pnpm start` (o endereço é sempre 127.0.0.1).
# PORT=5173

# Acesso pela rede local (outro aparelho na mesma Wi-Fi). Desligado por padrão.
# Com ACESSO_REDE=1 o site passa a atender a rede local; defina um PIN em Configurações antes.
# ACESSO_REDE=1
