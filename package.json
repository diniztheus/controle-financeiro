{
  "name": "controle-financeiro",
  "version": "0.1.0",
  "private": true,
  "description": "Controle financeiro pessoal que roda no seu computador, com banco SQLite local.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "vite build && node scripts/iniciar.ts",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "node scripts/iniciar.ts",
    "prepare": "svelte-kit sync && simple-git-hooks || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "backup": "node scripts/backup.ts",
    "restaurar": "node scripts/restaurar.ts",
    "importar": "node scripts/importar.ts",
    "iniciar-com-o-computador": "node scripts/iniciar-com-o-computador.ts",
    "parar-de-iniciar": "node scripts/parar-de-iniciar.ts",
    "icones": "node scripts/gerar-icones.ts",
    "dados-teste": "node scripts/gerar-dados-teste.ts",
    "desempenho": "node scripts/medir-desempenho.ts",
    "db:generate": "drizzle-kit generate",
    "verificar": "pnpm check && pnpm lint && pnpm test && pnpm test:e2e"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm check"
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "simple-git-hooks"
    ]
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@lucide/svelte": "^1.59.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
